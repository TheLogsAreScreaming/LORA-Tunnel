#!/bin/sh
# Screen (video), keyboard (input), radio SPI (spi), GPIO lines and cap power (gpio),
# antenna switch (i2c), the cap's GPS UART (dialout), and Recon's BLE scan (bluetooth) and
# Wi-Fi rescan through NetworkManager (netdev) for regular login users.
set -e
for user in $(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 {print $1}'); do
    for grp in video input spi gpio i2c dialout bluetooth netdev; do
        if getent group "$grp" >/dev/null; then
            usermod -aG "$grp" "$user" || true
        fi
    done
done
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/lora-tunnel.conf || true
fi
exit 0
